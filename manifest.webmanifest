{
  "name": "Scroll & Stitch",
  "short_name": "Stitch",
  "description": "Turn a screen recording or screenshots into one long screenshot, on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#faf7f3",
  "theme_color": "#faf7f3",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "video/*",
            "image/*",
            ".mov",
            ".mp4",
            ".m4v",
            ".png",
            ".jpg",
            ".jpeg",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  }
}
